# Bu dosyayı .env olarak kopyalayın ve anahtarınızı yazın.
ANTHROPIC_API_KEY=sk-ant-...

# İsteğe bağlı: Google (Gemini) ve DeepSeek modellerini kullanan masalar için
# GOOGLE_API_KEY=...        # ya da GEMINI_API_KEY  (aistudio.google.com)
# DEEPSEEK_API_KEY=sk-...   # platform.deepseek.com

# İsteğe bağlı: model seçimi (varsayılan: anthropic/claude-opus-5-5)
# PLAZA_MODEL=anthropic/claude-opus-5-5
# Yönetici ve çalışanlar için ayrı model (ör. çalışanları ucuzlatmak için):
# PLAZA_MANAGER_MODEL=anthropic/claude-opus-5-5
# PLAZA_STAFF_MODEL=anthropic/claude-sonnet-5-5
